# Copia a .env y ajusta. Solo las variables VITE_* llegan al navegador.
# Sin VITE_API_URL la web usa el proxy de Vite (/api → http://localhost:4000): mismo origen, sin CORS.
# Defínela solo si la API vive en otro dominio (y agrega ese origen a CORS_ORIGIN del backend).
# VITE_API_URL=http://localhost:4000/api/v1
# Solo en desarrollo: muestra los botones de usuarios de prueba en el login
VITE_DEMO_USERS=true
